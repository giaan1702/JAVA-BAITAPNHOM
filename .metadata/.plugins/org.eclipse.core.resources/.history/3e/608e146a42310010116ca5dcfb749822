package UI;

import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JFrame;

import DATA.User;
import Service.UserService;

import java.awt.*;
import javax.swing.*;
public class AddUser extends JFrame implements ActionListener {
	  private JTextField txtUsername;
	    private JPasswordField txtPassword;
	    private JComboBox<String> cbRole;
	    private JButton btnCreate, btnBack;
	    private UserService userService;
	public AddUser() {
		userService = new UserService();
        initUI();
	}
	
	private void initUI() {
        setTitle("Thêm người dùng mới");
        setSize(400, 200);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        
        JPanel mainPanel = new JPanel(new GridLayout(5, 2, 10, 10));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));

        // Các components
        mainPanel.add(new JLabel("Tên đăng nhập:"));
        txtUsername = new JTextField();
        mainPanel.add(txtUsername);

        mainPanel.add(new JLabel("Mật khẩu:"));
        txtPassword = new JPasswordField();
        mainPanel.add(txtPassword);

        mainPanel.add(new JLabel("Vai trò:"));
        cbRole = new JComboBox<>(new String[]{"Admin", "Staff"});
        mainPanel.add(cbRole);

        // Panel nút
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 10, 10));
        btnCreate = new JButton("Tạo tài khoản");
        btnBack = new JButton("Quay lại");
        
        btnCreate.addActionListener(this);
        btnBack.addActionListener(this);
        
        buttonPanel.add(btnCreate);
        buttonPanel.add(btnBack);

        add(mainPanel, BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);
    }
	
	@Override
	public void actionPerformed(ActionEvent e) {
		 if (e.getSource() == btnCreate) {
	            handleCreateUser();
	        } else if (e.getSource() == btnBack) {
	            dispose();
	        }
	}
	
	private void handleCreateUser() {
        String username = txtUsername.getText().trim();
        String password = new String(txtPassword.getPassword()).trim();
        int role = cbRole.getSelectedIndex() == 0 ? 1 : 0; // 1: Admin, 0: Staff

        // Validation
        if (username.isEmpty() || password.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Vui lòng điền đầy đủ thông tin!");
            return;
        }

        if (password.length() < 6) {
            JOptionPane.showMessageDialog(this, "Mật khẩu phải có ít nhất 6 ký tự!");
            return;
        }

        User newUser = new User(0, username, password, role);
        
        if (userService.themUser(newUser)) {
            JOptionPane.showMessageDialog(this, "Thêm người dùng thành công!");
            clearForm();
        } else {
            JOptionPane.showMessageDialog(this, "Thêm người dùng thất bại! Tên đăng nhập đã tồn tại");
        }
    }

    private void clearForm() {
        txtUsername.setText("");
        txtPassword.setText("");
        cbRole.setSelectedIndex(0);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new AddUser().setVisible(true));
    }
}


