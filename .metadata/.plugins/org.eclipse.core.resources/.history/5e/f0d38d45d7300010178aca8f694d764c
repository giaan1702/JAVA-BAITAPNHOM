package Service;

import java.util.List;

import DAO.NhanvienDAO;
import DATA.Nhanvien;

public class KhachHangService {
	private NhanvienDAO khDao = new NhanvienDAO();

    public boolean themKhachHang(Nhanvien kh) throws ClassNotFoundException {
        if (kh == null
            || kh.getHoTen().isBlank()
            || kh.getSoGiayTo().isBlank()) {
            return false;
        }
        // Kiểm tra trùng số giấy tờ
        Nhanvien exist = khDao.findBySoGiayTo(kh.getSoGiayTo());
        if (exist != null) {
            System.out.println("Số giấy tờ đã tồn tại.");
            return false;
        }
        return khDao.themKhachHang(kh);
    }

    public boolean suaKhachHang(Nhanvien kh) throws ClassNotFoundException {
        if (kh == null || kh.getId() <= 0) return false;
        return khDao.suaKhachHang(kh);
    }

    public boolean xoaKhachHang(int id) throws ClassNotFoundException {
        if (id <= 0) return false;
        return khDao.xoaKhachHang(id);
    }

    public List<Nhanvien> layTatCaKhachHang() throws ClassNotFoundException {
        return khDao.layTatCaKhachHang();
    }

    public Nhanvien timKhachHangTheoId(int id) {
        return khDao.findById(id);
    }

    public List<Nhanvien> timKhachHangTheoTen(String ten) {
        return khDao.findByName(ten);
    }
}
