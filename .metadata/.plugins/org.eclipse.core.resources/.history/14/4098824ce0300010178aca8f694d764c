package Service;

import java.util.List;

import DAO.KhachHangDAO;
import DATA.KhachHang;

public class KhachHangService {
	private KhachHangService khDao = new KhachHangService();

    public boolean themKhachHang(KhachHangService kh) throws ClassNotFoundException {
        if (kh == null
            || kh.getHoTen().isBlank()
            || kh.getSoGiayTo().isBlank()) {
            return false;
        }
        // Kiểm tra trùng số giấy tờ
        KhachHangService exist = khDao.findBySoGiayTo(kh.getSoGiayTo());
        if (exist != null) {
            System.out.println("Số giấy tờ đã tồn tại.");
            return false;
        }
        return khDao.themKhachHang(kh);
    }

    public boolean suaKhachHang(KhachHangService kh) throws ClassNotFoundException {
        if (kh == null || kh.getId() <= 0) return false;
        return khDao.suaKhachHang(kh);
    }

    public boolean xoaKhachHang(int id) throws ClassNotFoundException {
        if (id <= 0) return false;
        return khDao.xoaKhachHang(id);
    }

    public List<KhachHangService> layTatCaKhachHang() throws ClassNotFoundException {
        return khDao.layTatCaKhachHang();
    }

    public KhachHangService timKhachHangTheoId(int id) {
        return khDao.findById(id);
    }

    public List<KhachHangService> timKhachHangTheoTen(String ten) {
        return khDao.findByName(ten);
    }
}
