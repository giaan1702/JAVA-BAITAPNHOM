package DAO;

import java.sql.Connection;
import java.sql.Date;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

import DATA.DBConnection;
import DATA.LoaiPhong;
import DATA.Phong;

public class PhongDAO {
	public boolean themPhong(Phong p) throws ClassNotFoundException {
        String sql = "INSERT INTO phong (so_phong, id_loaiphong) VALUES (?, ?)";
        try (Connection connection = DBConnection.getConnection();
             PreparedStatement ps = connection.prepareStatement(sql)) {
           
            ps.setInt(1, p.getSoPhong());
            ps.setInt(2, p.getLoaiPhongId());
            return ps.executeUpdate() > 0;
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return false;
    }

    public boolean suaPhong(Phong p) throws ClassNotFoundException {
        String sql = "UPDATE phong SET so_phong=?, id_loaiphong=? ";
        try (Connection connection = DBConnection.getConnection();
             PreparedStatement ps = connection.prepareStatement(sql)) {
            ps.setInt(1, p.getSoPhong());
            ps.setInt(2, p.getLoaiPhongId());
        
            return ps.executeUpdate() > 0;
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return false;
    }

    public boolean xoaPhong(int id) throws ClassNotFoundException {
        String sql = "DELETE FROM phong WHERE so_phong=?";
        try (Connection connection = DBConnection.getConnection();
             PreparedStatement ps = connection.prepareStatement(sql)) {
            ps.setInt(1, id);
            return ps.executeUpdate() > 0;
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return false;
    }

    public List<Phong> layTatCaPhong() throws ClassNotFoundException {
        List<Phong> ds = new ArrayList<>();
        String sql = "SELECT * FROM phong";
        try (Connection connection = DBConnection.getConnection();
             Statement st = connection.createStatement();
             ResultSet rs = st.executeQuery(sql)) {
            while (rs.next()) {
                ds.add(new Phong(
                        
                        rs.getInt("so_phong"),
                        rs.getInt("id_loaiPhong")
                ));
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return ds;
    }
    public Phong findById(int id) {
        String sql = "SELECT * FROM phong WHERE id = ?";
        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, id);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return new Phong(
                      
                        rs.getInt("so_phong"),
                        rs.getInt("id_loaiphong")
                    );
                }
            }
        } catch (ClassNotFoundException | SQLException e) {
            e.printStackTrace();
        }
        return null;
    }
    public List<Phong> timPhongTrong(LocalDate from, LocalDate to, int loaiPhongId) {
        List<Phong> result = new ArrayList<>();
        StringBuilder sql = new StringBuilder("""
            SELECT p.* 
            FROM phong p
            WHERE p.so_phong NOT IN (
                SELECT dp.so_phong 
                FROM datphong dp 
                WHERE 
                    (dp.ngay_den <= ? AND dp.ngay_di >= ?) -- Phòng đã được đặt trong khoảng này
                    OR 
                    (dp.ngay_den BETWEEN ? AND ?)          -- Phòng có ngày đến nằm trong khoảng mới
                    OR 
                    (dp.ngay_di BETWEEN ? AND ?)           -- Phòng có ngày đi nằm trong khoảng mới
            )
        """);
        
        if (loaiPhongId != -1) {
            sql.append(" AND p.id_loaiphong = ?");
        }

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql.toString())) {

            // Set các tham số cho điều kiện chồng lấn
            ps.setDate(1, java.sql.Date.valueOf(to));
            ps.setDate(2, java.sql.Date.valueOf(from));
            ps.setDate(3, java.sql.Date.valueOf(from));
            ps.setDate(4, java.sql.Date.valueOf(to));
            ps.setDate(5, java.sql.Date.valueOf(from));
            ps.setDate(6, java.sql.Date.valueOf(to));

            if (loaiPhongId != -1) {
                ps.setInt(7, loaiPhongId); // Thêm tham số loại phòng
            }

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    result.add(new Phong(
                        rs.getInt("so_phong"),
                        rs.getInt("id_loaiphong")
                    ));
                }
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return result;
    }
    
    public Phong findBySoPhong(int soPhong) {
        String sql = "SELECT * FROM phong WHERE so_phong = ?";
        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, soPhong);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return new Phong(
                        
                        rs.getInt("so_phong"),
                        rs.getInt("id_loaiphong")
                    );
                }
            }
        } catch (ClassNotFoundException | SQLException e) {
            e.printStackTrace();
        }
        return null;
    }
    
    public LoaiPhong getLoaiPhong(int loaiPhongId) {
        return new LoaiPhongDAO().findById(loaiPhongId);
    }
}
